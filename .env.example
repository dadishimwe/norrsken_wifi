# Database
DATABASE_URL=postgres://norrsken:norrsken@localhost:5432/norrsken

# API
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# HMAC secret for report edit tokens (min 32 chars)
EDIT_TOKEN_SECRET=change-me-to-a-long-random-secret-at-least-32

# Optional: CIDR list for campus egress IPs (comma-separated). Off-campus → weight 0.3
# CAMPUS_IPS=203.0.113.0/24

# Slack (M3) — leave empty for M0–M2
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
SLACK_REMEMBER_LAST_ZONE=true
SLACK_OPS_CHANNEL=
SLACK_STATUS_CHANNEL=

# Ops dashboard — first admin (created only when ops_user table is empty)
OPS_ADMIN_USERNAME=admin
OPS_ADMIN_PASSWORD=change-me-admin-password-12chars
OPS_ADMIN_DISPLAY_NAME=Network Admin

# Optional override path to built ops UI (defaults to apps/web/ops/dist)
# OPS_STATIC_DIR=

# Deprecated single shared token (prefer per-user accounts above)
# OPS_TOKEN=

# Rate limits
RATE_REPORTS_PER_ZONE_PER_5MIN=1
RATE_REPORTS_PER_DAY=5
MIN_FILL_MS=1500

# Retention
REPORT_RETENTION_MONTHS=24

# Public URL used inside QR codes (no trailing slash)
# Example: http://192.168.1.50:8080  or  https://wifi.yourdomain.com
# Base URL baked into QR / “Copy link” (no trailing slash). Use the LAN address guests will open.
# PUBLIC_BASE_URL=http://192.168.1.13:8080
PUBLIC_BASE_URL=http://localhost:3000

# QR signing (private key gitignored — copy to VM or run pnpm qr:keygen)
# QR_PRIVATE_KEY_PATH=scripts/keys/qr-ed25519.pem
QR_KID=k1
