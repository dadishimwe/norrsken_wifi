{
  "name": "norrsken-network-feedback",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @norrsken/api dev",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "db:migrate": "pnpm --filter @norrsken/db migrate",
    "db:seed": "pnpm --filter @norrsken/db seed",
    "db:reset": "pnpm --filter @norrsken/db reset"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.2",
    "prettier": "^3.4.2"
  }
}
